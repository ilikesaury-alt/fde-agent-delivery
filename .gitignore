md-tools/
.workbuddy/
tools/*
!tools/*.ps1
!tools/*.bat
!tools/*.md

# 调研阶段克隆的第三方参考仓库（不属于本产品交付物，避免混入历史）
research/

# v1 手写栈备份（仅本地对照，不提交）
legacy/

# 系统
.DS_Store
Thumbs.db

# Windows 保留名误创建的空文件（如 `cmd >nul` 在 Git Bash 下落盘）
nul

# 临时排查日志
tmp-*.log

# 编辑器
.vscode/
.idea/

# 本地 wrangler 试验配置
.wrangler-local.json

# 临时 CDP trace 产物（体积大、可重生成）
**/trace.json

# pi 运行时产物（任务日志、子 agent 会话、预算等；非交付物）
.pi/tasks/
.pi/delegate/
.pi/fusion/

# pi 本地资源（含 junction 链接，git 无法表达语义；重建见 docs/pi-skills-setup.md）
.pi/skills/

# ORT wasm 运行时是构建产物（scripts/copy-ort.mjs 从 node_modules 复制），不入库
product4/public/ort/
