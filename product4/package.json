{
  "name": "health-track",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/copy-ort.mjs && vite build && node scripts/prune-assets.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types test/run.ts",
